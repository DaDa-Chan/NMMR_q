{
  "data_configs": {
    "sgd": {
      "data_path": "./data/SGD",
      "n_samples": 5000,
      "scenario": 1
    }
  },
  "train_params": {
    "model_name": "nmmr_h",
    "loss_name": "U_statistic",
    "n_epochs": 300,
    "batch_size": {
      "type": "categorical",
      "choices": [
        32,
        64,
        128
      ]
    },
    "patience": 30,
    "scheduler_patience": 10,
    "scheduler_factor": 0.5,
    "n_splits": 5,
    "log_metrics": true,
    "network_depth": {
      "type": "categorical",
      "choices": [
        2,
        3,
        4,
        5
      ]
    },
    "use_u_statistic": true,
    "hpo_n_trials": 10,
    "learning_rate": {
      "type": "float",
      "low": 0.0001,
      "high": 0.005,
      "log": true
    },
    "network_width": {
      "type": "categorical",
      "choices": [
        32,
        64,
        128
      ]
    },
    "l2_penalty": {
      "type": "float",
      "low": 1e-07,
      "high": 0.001,
      "log": true
    },
    "early_stopping_min_delta": 1e-05,
    "scheduler_min_lr": 1e-06,
    "kernel_bandwidth_multiplier": {
      "type": "categorical",
      "choices": [
        0.25,
        0.5,
        1,
        2
      ]
    }
  }
}
